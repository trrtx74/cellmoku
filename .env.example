# Supabase 접속 정보 (게임 기록 저장용)
# Supabase 대시보드 > Project Settings > API Keys 에서 확인
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채워 넣으세요.
#   cp .env.example .env.local
# 이 두 값은 정적 사이트 번들에 포함되어 공개됩니다(publishable key는 공개 전제 값).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# 신규 publishable key (sb_publishable_...) 권장. 구 anon 키를 쓰면 VITE_SUPABASE_ANON_KEY 로 넣어도 됩니다.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
